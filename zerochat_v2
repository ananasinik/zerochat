#!/usr/bin/env python3

import socket
import threading
import json
import os
import sys
import struct
from pathlib import Path

VERSION = "2.0.0"
DEFAULT_PORT = 5000

CONFIG_DIR = Path.home() / ".config" / "zerochat"
HOSTS_FILE = CONFIG_DIR / "hosts.json"
CONFIG_FILE = CONFIG_DIR / "config.json"

def ensure_config():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)

    if not HOSTS_FILE.exists():
        HOSTS_FILE.write_text("{}")

    if not CONFIG_FILE.exists():
        CONFIG_FILE.write_text(
            json.dumps(
                {
                    "username": "Anonymous"
                },
                indent=4
            )
        )

def send_packet(sock, packet):

    data = json.dumps(packet).encode()

    length = struct.pack("!I", len(data))

    sock.sendall(length)

    sock.sendall(data)

def receive_exact(sock, size):

    data = b""

    while len(data) < size:

        chunk = sock.recv(size - len(data))

        if not chunk:
            return None

        data += chunk

    return data

def receive_packet(sock):

    header = receive_exact(sock, 4)

    if header is None:
        return None

    length = struct.unpack("!I", header)[0]

    payload = receive_exact(sock, length)

    if payload is None:
        return None

    return json.loads(payload.decode())



def load_hosts():
    ensure_config()

    with open(HOSTS_FILE, "r") as f:
        return json.load(f)


def save_hosts(hosts):
    ensure_config()

    with open(HOSTS_FILE, "w") as f:
        json.dump(hosts, f, indent=4)

def load_config():
    ensure_config()

    with open(CONFIG_FILE, "r") as f:
        return json.load(f)


def save_config(cfg):
    ensure_config()

    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=4)

def usage():
    print(f"""
ZeroChat {VERSION}

Commands

listen [port]
connect <host|ip> [port]

addhost <name> <ip>
removehost <name>
hosts

username <name>
whoami

help
version
""")

class Connection:
    def __init__(self, sock, address):
        self.sock = sock
        self.address = address
        self.running = True

    def send(self, message):

        username = load_config()["username"]

        packet = {
            "type": "text",
            "username": username,
            "message": message
        }

        send_packet(self.sock, packet)

    def receive_loop(self):

            while self.running:

                try:

                    packet = receive_packet(self.sock)

                    if packet is None:
                        break

                    packet_type = packet.get("type")

                    if packet_type == "text":

                        print(
                            f"\n{packet['username']}: {packet['message']}"
                        )

                        print("> ", end="", flush=True)

                    else:

                        print("\nUnknown packet received.")

                except Exception as e:

                    print(f"\nReceive error: {e}")

                    break

            self.running = False

            try:
                self.sock.close()
            except:
                pass

            print("\nConnection closed.")

def start_chat(connection):
    threading.Thread(
        target=connection.receive_loop,
        daemon=True
    ).start()

    while connection.running:
        try:
            message = input("> ")

            if not message:
                continue

            connection.send(message)

        except (EOFError, KeyboardInterrupt):
            break

    connection.running = False


def listen(port):
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

    server.bind(("0.0.0.0", port))

    server.listen(1)

    print(f"Listening on port {port}...")

    sock, addr = server.accept()

    print(f"Connected to {addr[0]}:{addr[1]}")

    connection = Connection(sock, addr)

    start_chat(connection)

def connect(target, port):
    hosts = load_hosts()

    if target in hosts:
        ip = hosts[target]
        print(f"Connecting to {target} ({ip})...")
    else:
        ip = target
        print(f"Connecting to {ip}...")

    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

    try:
        s.connect((ip, port))
    except Exception as e:
        print(f"Connection failed: {e}")
        return

    print("Connected!")

    connection = Connection(s, ip)

    start_chat(connection)

def main():

    ensure_config()

    if len(sys.argv) < 2:
        usage()
        return

    command = sys.argv[1]

    if command == "listen":

        if len(sys.argv) >= 3:
            port = int(sys.argv[2])
        else:
            port = DEFAULT_PORT

        listen(port)

    elif command == "connect":

        if len(sys.argv) < 3:
            print("Missing host or IP.")
            return

        target = sys.argv[2]

        if len(sys.argv) >= 4:
            port = int(sys.argv[3])
        else:
            port = DEFAULT_PORT

        connect(target, port)

    elif command == "addhost":

        if len(sys.argv) != 4:
            print("Usage: zerochat addhost <name> <ip>")
            return

        hosts = load_hosts()

        hosts[sys.argv[2]] = sys.argv[3]

        save_hosts(hosts)

        print(f"Added host '{sys.argv[2]}'.")

    elif command == "removehost":

        if len(sys.argv) != 3:
            print("Usage: zerochat removehost <name>")
            return

        hosts = load_hosts()

        if sys.argv[2] in hosts:
            del hosts[sys.argv[2]]
            save_hosts(hosts)
            print("Host removed.")
        else:
            print("Host not found.")

    elif command == "hosts":

        hosts = load_hosts()

        if not hosts:
            print("No saved hosts.")
        else:
            for name, ip in hosts.items():
                print(f"{name:15} {ip}")

    elif command == "username":

        if len(sys.argv) != 3:
            print("Usage: zerochat username <name>")
            return

        cfg = load_config()
        cfg["username"] = sys.argv[2]
        save_config(cfg)

        print("Username saved.")

    elif command == "whoami":

        cfg = load_config()

        print(cfg["username"])

    elif command == "version":

        print(f"ZeroChat {VERSION}")

    elif command == "help":

        usage()

    else:

        print("Unknown command.")
        usage()


if __name__ == "__main__":
    main()

